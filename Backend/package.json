{
  "name": "sacco-management-system",
  "version": "1.0.0",
  "description": "Production-ready Multi-Tenant SACCO Management System Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --runInBand --forceExit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sequelize": "^6.37.3",
    "mysql2": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "redis": "^4.7.0",
    "ioredis": "^5.4.1",
    "socket.io": "^4.7.5",
    "bullmq": "^5.12.12",
    "nodemailer": "^6.9.14",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.3.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "joi": "^17.13.3",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "uuid": "^10.0.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "exceljs": "^4.4.0",
    "axios": "^1.7.2",
    "crypto": "^1.0.1",
    "xss": "^1.0.15",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6",
    "compression": "^1.7.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "node-cron": "^3.0.3",
    "moment": "^2.30.1",
    "lodash": "^4.17.21",
    "otp-generator": "^4.0.1",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@jest/globals": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "eslint": "^9.5.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
