# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME="SACCO Management System"
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sacco_management_system
DB_USER=sacco_user
DB_PASSWORD=NewSecurePassword2026!
DB_DIALECT=mysql

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your-very-long-access-secret-key-here
JWT_REFRESH_SECRET=your-very-long-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=2h
JWT_EMAIL_VERIFY_EXPIRES_IN=48h

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="SACCO System <no-reply@sacco.co.ke>"

# ─────────────────────────────────────────────
# M-Pesa (Safaricom Daraja)
# ─────────────────────────────────────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/mpesa/callback
MPESA_B2C_INITIATOR=your-initiator
MPESA_B2C_SECURITY_CREDENTIAL=your-security-credential

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
COOKIE_SECRET=your-cookie-secret
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# File uploads
# ─────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DEST=src/uploads

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
